# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
"postgresql://postgres:FAzx@#12ZXaf@db.afpatcubzjrlrdmluzeg.supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET="change-this-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# ─────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────
ADMIN_JWT_SECRET="change-this-to-admin-specific-secret"
ADMIN_JWT_EXPIRES_IN="8h"

# ─────────────────────────────────────────────
# SMS — Primary Gateway (SSL Wireless)
# https://www.sslwireless.com/
# ─────────────────────────────────────────────
SSL_WIRELESS_USERNAME="your_sslwireless_username"
SSL_WIRELESS_PASSWORD="your_sslwireless_password"
SSL_WIRELESS_SENDER_ID="ELEARN"
SSL_WIRELESS_API_URL="https://sms.sslwireless.com/pushapi/dynamic/server.php"

# ─────────────────────────────────────────────
# SMS — Fallback Gateway (Alpha SMS / BulkSMSBD)
# Set SMS_FALLBACK_ENABLED=true to activate automatic failover
# https://www.alphasms.com.bd/  or  https://bulksmsbd.net/
# ─────────────────────────────────────────────
SMS_FALLBACK_ENABLED=false
ALPHA_SMS_API_KEY="your_alpha_sms_api_key"
ALPHA_SMS_SENDER_ID="ELEARN"
ALPHA_SMS_API_URL="https://api.alphasms.com.bd/api/sms/plain"

# ─────────────────────────────────────────────
# FILE STORAGE
# STORAGE_PROVIDER: "s3" | "b2" | "local"
# ─────────────────────────────────────────────
STORAGE_PROVIDER="s3"

# AWS S3 (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="elearning-private-storage"
AWS_S3_PUBLIC_BUCKET="elearning-public-assets"

# Backblaze B2 (if STORAGE_PROVIDER=b2 — cheaper egress than S3)
# B2 is S3-compatible; uses the same StorageService via endpoint override
B2_KEY_ID="your_b2_key_id"
B2_APP_KEY="your_b2_app_key"
B2_BUCKET_NAME="elearning-private"
B2_PUBLIC_BUCKET_NAME="elearning-public"
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"   # update to your region

# ─────────────────────────────────────────────
# VIDEO STREAMING (Bunny.net Stream)
# ─────────────────────────────────────────────
BUNNY_STREAM_API_KEY="your_bunny_stream_api_key"
BUNNY_STREAM_LIBRARY_ID="your_library_id"
BUNNY_CDN_HOSTNAME="vz-xxxxxx.b-cdn.net"

# ─────────────────────────────────────────────
# BACKEND (NestJS)
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000"

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
THROTTLE_TTL=60000           # window in ms (60 seconds)
THROTTLE_LIMIT=60            # max requests per window (global)
THROTTLE_OTP_LIMIT=5         # stricter limit for /auth/login & /auth/otp

# ─────────────────────────────────────────────
# FRONTEND (Next.js public vars)
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="শিক্ষা"
NEXT_PUBLIC_SUPPORT_PHONE="+8801XXXXXXXXX"
NEXT_PUBLIC_SUPPORT_EMAIL="support@shikkha.com.bd"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/shikkhabd"

# ─────────────────────────────────────────────
# NOTIFICATIONS
# ─────────────────────────────────────────────
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=false

# WhatsApp Business API (set NOTIFICATION_WHATSAPP_ENABLED=true to activate)
# Supported providers: Twilio, Meta Cloud API, Wassenger
WHATSAPP_API_URL="https://api.twilio.com/2010-04-01/Accounts/ACXXX/Messages.json"
WHATSAPP_ACCOUNT_SID="your_twilio_account_sid"
WHATSAPP_AUTH_TOKEN="your_twilio_auth_token"
WHATSAPP_FROM_NUMBER="whatsapp:+14155238886"   # sandbox or approved business number
