{
  "name": "bangla-elearning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "npm run start --prefix=apps/api",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prisma": "^5.15.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
